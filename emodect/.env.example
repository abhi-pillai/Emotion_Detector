# Copy this file to .env and fill in real values. Never commit .env itself.

# Required - get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional - override the Gemini model used (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Required in production - generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# development | production | testing
FLASK_CONFIG=development

# Database connection string. Defaults to a local SQLite file under ./instance
DATABASE_URL=sqlite:///instance/emotions.db

# Port the app listens on
PORT=8000

# --- Email (account confirmation + password reset) ---
# Sent via the Brevo API (https://www.brevo.com) over HTTPS - not raw SMTP.
# Many hosting platforms (Render, Railway, Heroku, etc.) block outbound
# SMTP ports (25/465/587) to prevent spam abuse, which raw smtplib can't
# work around. HTTPS (443) is never blocked, so this is the reliable path
# for sending email from a hosted app.
#
# 1. Sign up free at https://app.brevo.com (300 emails/day free, no expiry)
# 2. Add your sender email: Senders, Domains & Dedicated IPs -> Senders ->
#    Add a Sender, then click the verification link Brevo emails you.
#    (No domain needed - this works with a plain Gmail/Outlook address.)
# 3. Create an API key: SMTP & API -> API Keys -> Generate a new API key
# 4. Set the verified sender address as MAIL_DEFAULT_SENDER below
BREVO_API_KEY=your_brevo_api_key_here
MAIL_DEFAULT_SENDER=your_verified_sender@example.com

# Base URL used to build links inside emails (confirmation/reset).
# Local dev: http://localhost:8000
# Production: your real deployed URL, e.g. https://your-app.onrender.com
APP_BASE_URL=http://localhost:8000

# Leave BREVO_API_KEY blank (or unset) to skip real email sending entirely -
# confirmation/reset links will just be printed to the console/log instead,
# which is convenient for local development.
