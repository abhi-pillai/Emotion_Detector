# Copy this file to .env and fill in real values. Never commit .env itself.

# Required - get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional - override the Gemini model used (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Required in production - generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# development | production | testing
FLASK_CONFIG=development

# Database connection string. Defaults to a local SQLite file under ./instance
DATABASE_URL=sqlite:///instance/emotions.db

# Port the app listens on
PORT=8000

# --- Email (account confirmation + password reset) ---
# Using Gmail SMTP: create an "App Password" at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# enabled on the Google account). Do NOT use your normal Gmail password here.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_DEFAULT_SENDER=youraddress@gmail.com

# Base URL used to build links inside emails (confirmation/reset).
# Local dev: http://localhost:8000
# Production: your real deployed URL, e.g. https://your-app.onrender.com
APP_BASE_URL=http://localhost:8000

# Leave MAIL_SERVER blank (or unset) to skip real email sending entirely -
# confirmation/reset links will just be printed to the console/log instead,
# which is convenient for local development.
