# Copy this file to .env and fill in real values. Never commit .env itself.

# Required - get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional - override the Gemini model used (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Required in production - generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# development | production | testing
FLASK_CONFIG=development

# Database connection string. Defaults to a local SQLite file under ./instance
DATABASE_URL=sqlite:///instance/emotions.db

# Port the app listens on
PORT=8000

# --- Email (account confirmation + password reset) ---
# Sent via the Gmail API (https://developers.google.com/gmail/api) over
# HTTPS - not raw SMTP. Many hosting platforms (Render, Railway, Heroku,
# etc.) block outbound SMTP ports (25/465/587) to prevent spam abuse, which
# raw smtplib can't work around. HTTPS (443) is never blocked, so this is
# the reliable path for sending email from a hosted app.
#
# One-time setup:
# 1. In Google Cloud Console (https://console.cloud.google.com):
#    a. Create/select a project.
#    b. Enable the "Gmail API" (APIs & Services -> Library).
#    c. Configure the OAuth consent screen (External is fine; add your own
#       Gmail address under "Test users" if it stays in "Testing" mode).
#    d. Create OAuth client credentials of type "Desktop app"
#       (APIs & Services -> Credentials -> Create Credentials ->
#       OAuth client ID). Download the client ID and client secret.
# 2. Run: python get_gmail_refresh_token.py
#    This opens a browser, has you log into the Gmail account you want to
#    send from, and prints a refresh token to paste in below.
# 3. Set the Gmail address you authorized as MAIL_DEFAULT_SENDER below.
GMAIL_CLIENT_ID=your_gmail_oauth_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token_here
MAIL_DEFAULT_SENDER=your_gmail_address@gmail.com

# Base URL used to build links inside emails (confirmation/reset).
# Local dev: http://localhost:8000
# Production: your real deployed URL, e.g. https://your-app.onrender.com
APP_BASE_URL=http://localhost:8000

# Leave GMAIL_REFRESH_TOKEN blank (or unset) to skip real email sending
# entirely - confirmation/reset links will just be printed to the
# console/log instead, which is convenient for local development.
